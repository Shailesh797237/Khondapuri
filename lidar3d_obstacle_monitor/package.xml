<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lidar3d_obstacle_monitor</name>
  <version>1.0.0</version>
  <description>
    3D obstacle detection using a pre-built PCD map and live Livox point cloud.
    Detects dynamic obstacles at ALL heights (including overhead / top surface)
    that the 2D LaserScan cannot see.
  </description>
  <maintainer email="taikisha@taikisha.com">taikisha</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ROS2 core -->
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_sensor_msgs</depend>
  <depend>tf2_eigen</depend>

  <!-- PCL -->
  <depend>pcl_conversions</depend>
  <depend>pcl_ros</depend>

  <!-- Launch -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
