  <joint name="backlidar" type="fixed">
    <origin xyz="-0.690 -0.395 0.1087" rpy="0 0 -2.3562"/>
    <parent link="base_link"/>
    <child link="back_lidar"/>
  </joint>

  <!-- IMU SENSOR -->
  <link name="imu_sensor">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.0031"/>
      <inertia ixx="0.0000002" ixy="0" ixz="0" iyy="0.0000006" iyz="0" izz="0.0000004"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="package://my_robot_description/meshes/imu_sensor.STL"/>
      </geometry>
      <material name="sensor_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="package://my_robot_description/meshes/imu_sensor.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="imusensor" type="fixed">
    <origin xyz="0.00020298 0.000029087 0.240" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="imu_sensor"/>
  </joint>

  <!-- LIVOX MID-360 LIDAR -->
  <link name="livox_frame">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.43"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.0325" length="0.065"/>
      </geometry>
      <material name="sensor_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.0325" length="0.065"/>
      </geometry>
    </collision>
  </link>

  <joint name="livox_joint" type="fixed">
    <origin xyz="0.0 0.0 0.334" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="livox_frame"/>
  </joint>

  <gazebo reference="base_link">
    <visual>
      <geometry>
        <mesh filename="package://my_robot_description/meshes/base_link.STL"/>
      </geometry>
      <material>
        <ambient>0.15 0.55 0.95 1</ambient>
        <diffuse>0.25 0.55 0.95 1</diffuse>
      </material>
    </visual>
  </gazebo>

</robot>