<?xml version="1.0" encoding="utf-8"?>
<!-- dev_2.urdf: Corrected according to exact diagram & prompt specifications:
       - Total Length (L): 1380 mm -> x = +-0.690 m
       - Total Width (B):  790 mm  -> y = +-0.395 m
       - Drive wheel track width (left_wheel <-> right_wheel)   : 600 mm -> y = +-0.300 m
       - Idler wheel track width (left_idler <-> right_idler)   : 400 mm -> y = +-0.200 m
       - Drive-wheel centerline -> front/back idlers (x offset) : 500 mm -> x = +-0.500 m
       - Diagonal Lidars:
           * Front Lidar (Top-Left corner)    : x = +0.690 m, y = +0.395 m
           * Back Lidar  (Bottom-Right corner) : x = -0.690 m, y = -0.395 m
     Meshes rotated rpy="1.5708 0 0" (STL Y-up -> ROS Z-up).
-->
<robot name="my_robot_description">

  <!-- ================= MATERIAL DEFINITIONS ================= -->
  <material name="white">
    <color rgba="1 1 1 1"/>
  </material>

  <material name="robot_blue">
    <color rgba="0.25 0.55 0.95 1"/>
  </material>

  <material name="dark_blue">
    <color rgba="0.1 0.25 0.6 1"/>
  </material>

  <material name="sensor_grey">
    <color rgba="0.6 0.6 0.6 1"/>
  </material>

  <!-- base_link -->
  <link name="base_link">
    <inertial>
      <origin xyz="-0.00171603826927133 0.0853153097271832 -0.000800676203164504" rpy="0 0 0"/>
      <mass value="63.11417452"/>
      <inertia ixx="0.890487" ixy="-0.000988" ixz="0.023677" iyy="2.489288" iyz="-0.000110" izz="3.097446"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="package://my_robot_description/meshes/base_link.STL"/>
      </geometry>
      <material name="robot_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="package://my_robot_description/meshes/base_link.STL"/>
      </geometry>
    </collision>
  </link>

  <!-- LEFT WHEEL (Y = +0.300 m, 600mm drive track width) -->
  <link name="left_wheel">
    <inertial>
      <origin xyz="0 0 0.018" rpy="0 0 0"/>
      <mass value="2.317732"/>
      <inertia ixx="0.011516" ixy="-0.000011" ixz="0" iyy="0.006082" iyz="-0.000078" izz="0.011441"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="package://my_robot_description/meshes/left_wheel.STL"/>
      </geometry>
      <material name="robot_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="package://my_robot_description/meshes/left_wheel.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="leftwheel" type="continuous">
    <origin xyz="0 0.300 0.042531" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <axis xyz="0 1 0"/>
  </joint>
  <gazebo reference="left_wheel">
    <mu1>1.2</mu1>
    <mu2>0.85</mu2>
    <kp>100000</kp>
    <kd>300</kd>
  </gazebo>

  <!-- RIGHT WHEEL (Y = -0.300 m, 600mm drive track width) -->
  <link name="right_wheel">
    <inertial>
      <origin xyz="0 0 -0.018" rpy="0 0 0"/>
      <mass value="2.317732"/>
      <inertia ixx="0.011516" ixy="-0.000011" ixz="0" iyy="0.006082" iyz="0.000078" izz="0.011441"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="package://my_robot_description/meshes/right_wheel.STL"/>
      </geometry>
      <material name="robot_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="package://my_robot_description/meshes/right_wheel.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="rightwheel" type="continuous">
    <origin xyz="0 -0.300 0.042531" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <axis xyz="0 1 0"/>
  </joint>
  <gazebo reference="right_wheel">
    <mu1>1.2</mu1>
    <mu2>0.85</mu2>
    <kp>100000</kp>
    <kd>300</kd>
  </gazebo>

  <!-- FRONT LEFT IDLER (X = +0.500 m, Y = +0.200 m, 400mm idler track width) -->
  <link name="front_left_idler_link">
    <inertial>
      <origin xyz="0 0 0.001" rpy="0 0 0"/>
      <mass value="0.5506"/>
      <inertia ixx="0.000804" ixy="0" ixz="0.000277" iyy="0.000975" iyz="0" izz="0.000756"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="package://my_robot_description/meshes/front_idler.STL"/>
      </geometry>
      <material name="dark_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="package://my_robot_description/meshes/front_idler.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="front_left_idler" type="fixed">
    <origin xyz="0.500 0.200 0.071" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="front_left_idler_link"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- FRONT RIGHT IDLER (X = +0.500 m, Y = -0.200 m, 400mm idler track width) -->
  <link name="front_right_idler_link">
    <inertial>
      <origin xyz="0 0 0.001" rpy="0 0 0"/>
      <mass value="0.5506"/>
      <inertia ixx="0.000804" ixy="0" ixz="0.000277" iyy="0.000975" iyz="0" izz="0.000756"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="package://my_robot_description/meshes/front_idler.STL"/>
      </geometry>
      <material name="dark_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="package://my_robot_description/meshes/front_idler.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="front_right_idler" type="fixed">
    <origin xyz="0.500 -0.200 0.071" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="front_right_idler_link"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- BACK LEFT IDLER (X = -0.500 m, Y = +0.200 m, 400mm idler track width) -->
  <link name="back_left_idler_link">
    <inertial>
      <origin xyz="0 0 0.016" rpy="0 0 0"/>
      <mass value="0.5506"/>
      <inertia ixx="0.000804" ixy="0" ixz="-0.000277" iyy="0.000975" iyz="0" izz="0.000756"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="package://my_robot_description/meshes/back_idler.STL"/>
      </geometry>
      <material name="dark_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="package://my_robot_description/meshes/back_idler.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="back_left_idler" type="fixed">
    <origin xyz="-0.500 0.200 0.071" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="back_left_idler_link"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- BACK RIGHT IDLER (X = -0.500 m, Y = -0.200 m, 400mm idler track width) -->
  <link name="back_right_idler_link">
    <inertial>
      <origin xyz="0 0 0.016" rpy="0 0 0"/>
      <mass value="0.5506"/>
      <inertia ixx="0.000804" ixy="0" ixz="-0.000277" iyy="0.000975" iyz="0" izz="0.000756"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="package://my_robot_description/meshes/back_idler.STL"/>
      </geometry>
      <material name="dark_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="package://my_robot_description/meshes/back_idler.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="back_right_idler" type="fixed">
    <origin xyz="-0.500 -0.200 0.071" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="back_right_idler_link"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- FRONT LIDAR (Top-Left Diagonal Corner: X = +0.690 m, Y = +0.395 m) -->
  <link name="front_lidar">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.6404"/>
      <inertia ixx="0.000904" ixy="0.000216" ixz="-0.000045" iyy="0.001255" iyz="0" izz="0.001536"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="package://my_robot_description/meshes/front_lidar.STL"/>
      </geometry>
      <material name="sensor_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="package://my_robot_description/meshes/front_lidar.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="frontlidar" type="fixed">
    <origin xyz="0.690 0.395 0.1087" rpy="0 0 0.7854"/>
    <parent link="base_link"/>
    <child link="front_lidar"/>
  </joint>

  <!-- BACK LIDAR (Bottom-Right Diagonal Corner: X = -0.690 m, Y = -0.395 m) -->
  <link name="back_lidar">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.6404"/>
      <inertia ixx="0.000904" ixy="0.000216" ixz="0.000045" iyy="0.001255" iyz="0" izz="0.001536"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="package://my_robot_description/meshes/back_lidar.STL"/>
